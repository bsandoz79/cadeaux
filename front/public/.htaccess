# Les adresses du site (/bilan, /c/…) renvoient vers index.html. L'API a son propre .htaccess dans /api.
RewriteEngine On
RewriteBase /

# HTTPS obligatoire
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^index\.html$ - [L]

# Lien d'une cagnotte : page servie par PHP avec l'aperçu (titre, avancement, image) pour Snapchat, WhatsApp…
RewriteRule ^c/([a-f0-9]{16})/apercu\.png$ api/partage.php?code=$1&image=1 [L]
RewriteRule ^c/([a-f0-9]{16})/?$ api/partage.php?code=$1 [L]
# Pages de guide écrites à la construction : /liste-de-noel sert liste-de-noel.html.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z-]+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Seul le code du site s'exécute ; photos de produits acceptées depuis n'importe quel site en https.
  # style-src-attr : React écrit quelques styles dans l'attribut style (largeur des barres d'avancement).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Pages privées (compte, liens partagés, liens reçus par e-mail) : jamais dans Google. THE_REQUEST garde l'adresse demandée.
  <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(occasions|proches|bilan|idees|envies|cagnottes|compte|recherche|l/|c/|motdepasse|confirmer|securite|rejoindre)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  <FilesMatch "\.(html|webmanifest|xml|txt)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
